from building import *

cwd = GetCurrentDir()

# 飞控参数分区存储 (W25Q64):
#   param_part   分区引擎 (分区表副本 + 追加式记录 + CRC + 磨损均衡)
#   param_calib  传感器标定域 (原 calibration/calib_store 迁移, API 不变)
#   param_nav    导航参数域 (磁偏角/NOGNSS 部署位置/轴向映射, 缺省=gins_config.h)
#   param_sys    系统参数域 (启动计数/固件标识/迁移标志)
# 依赖: middleware/Sensor_Drivers (sensor_w25q64.h) 与 middleware/gins (gins_config.h)
# 与 CMakeLists.txt 的 RT_PARAMCALIB_SOURCES 保持一致
src = Glob('*.c')
CPPPATH = [cwd, cwd + '/../../Sensor_Drivers', cwd + '/../../Navigation/gins']

group = DefineGroup('ParamCalib', src, depend = [''], CPPPATH = CPPPATH)

Return('group')
