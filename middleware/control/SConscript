import os
from building import *

cwd = GetCurrentDir()

# 飞控控制层: 凡含 SConscript 的子目录自动编入 —— position_mpc (外环 MPC)
# / attitude_so3 (内环 SO3+PID), 两个目录均 "纯 C 核心 + gins 桥接" 拆分
# (同 middleware/so3 模式)
objs = []
list = os.listdir(cwd)
for item in list:
    if os.path.isfile(os.path.join(cwd, item, 'SConscript')):
        objs = objs + SConscript(os.path.join(item, 'SConscript'))

Return('objs')
